    u_xlat2.xyz = vec3(uintBitsToFloat(inMatrices_buf[u_xlati2.w].value[(16 >> 2) + 0]), uintBitsToFloat(inMatrices_buf[u_xlati2.w].value[(16 >> 2) + 1]), uintBitsToFloat(inMatrices_buf[u_xlati2.w].value[(16 >> 2) + 2]));
