    u_xlat2 = u_xlat8 * u_xlat1.wwww + u_xlat4;
    u_xlat4 = u_xlat9 * u_xlat1.wwww + u_xlat5;
    u_xlat1 = u_xlat7 * u_xlat1.wwww + u_xlat3;
    u_xlat0.w = 1.0;
    u_xlat2.x = dot(u_xlat2, u_xlat0);
    u_xlat2.y = dot(u_xlat4, u_xlat0);
    u_xlat2.z = dot(u_xlat1, u_xlat0);
    outVertices_buf[gl_GlobalInvocationID.x].value[(0 >> 2)] = uint(floatBitsToUint(u_xlat2.x));
