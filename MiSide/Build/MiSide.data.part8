    u_xlat3.y = dot(u_xlat6, u_xlat1);
    u_xlat3.z = dot(u_xlat2, u_xlat1);
    outVertices_buf[(u_xlati0 >> 2)] = uint(floatBitsToUint(u_xlat3.x));
    outVertices_buf[(u_xlati0 >> 2) + 1] = uint(floatBitsToUint(u_xlat3.y));
    outVertices_buf[(u_xlati0 >> 2) + 2] = uint(floatBitsToUint(u_xlat3.z));
    return;
}
