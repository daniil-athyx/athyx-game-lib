    u_xlat4 = u_xlat7 * u_xlat1.xxxx + u_xlat10;
    u_xlat5 = u_xlat8 * u_xlat1.xxxx + u_xlat11;
    u_xlat3 = u_xlat6 * u_xlat1.xxxx + u_xlat3;
